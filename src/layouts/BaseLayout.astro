---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const {title="Vincenzo's Fish & Chips Van® | Central Scotland",description="Multi award-winning mobile fish and chips across Stirling District and Central Scotland.",image='/assets/images/press/van-launch.jpg'}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://vincenzoschipvan.com');
const schema={'@context':'https://schema.org','@type':'FoodTruck',name:"Vincenzo's Fish & Chips Van",url:'https://vincenzoschipvan.com',image:'https://vincenzoschipvan.com/assets/images/press/van-launch.jpg',telephone:'+447985522449',email:'info@vincenzosfishandchips.com',priceRange:'££',servesCuisine:'Fish and chips',areaServed:['Stirling District','Central Scotland','Scotland'],sameAs:['https://www.facebook.com/VincenzosFishAndChipsVan/','https://www.instagram.com/vincenzos_fishandchips/','https://www.tiktok.com/@vincenzos_fishandchips']};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><meta name="theme-color" content="#111111"><link rel="canonical" href={canonical}><link rel="icon" type="image/png" href="/assets/images/logo-original.png"><meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:image" content={new URL(image,'https://vincenzoschipvan.com')}><meta name="twitter:card" content="summary_large_image"><title>{title}</title><script type="application/ld+json" set:html={JSON.stringify(schema)}></script></head><body><Header/><main><slot/></main><Footer/></body></html>
