---
const path=Astro.url.pathname;
const links=[['/','Home'],['/schedule','Find Us'],['/menu','Menu'],['/contact','Contact']];
const more=[['/story','Our Story'],['/awards','Awards'],['/press','Press'],['/gallery','Gallery'],['/winter-service','Winter Service'],['/event-compliance-portal','Compliance Portal']];
const isActive=(href:string)=>href==='/'?path==='/':path.startsWith(href);
---
<header id="siteHeader" class="header">
  <div class="bar">
    <a class="brand" href="/" aria-label="Vincenzo's Fish & Chips Van home"><img src="/assets/images/logo-original.png" alt="Vincenzo's Fish & Chips Van original logo" width="140" height="140"></a>
    <button id="menuButton" class="menu" aria-label="Open menu" aria-controls="nav" aria-expanded="false"><span></span><span></span><span></span></button>
    <nav id="nav" aria-label="Main navigation">{links.map(([href,label])=><a class:list={{active:isActive(href)}} aria-current={isActive(href)?'page':undefined} href={href}>{label}</a>)}<details class="more"><summary class:list={{'more-active':more.some(([href])=>isActive(href))}}>Discover <span aria-hidden="true">⌄</span></summary><div class="more-links">{more.map(([href,label])=><a class:list={{active:isActive(href)}} aria-current={isActive(href)?'page':undefined} href={href}>{label}</a>)}</div></details><a class:list={{book:true,active:isActive('/events')}} aria-current={isActive('/events')?'page':undefined} href="/events">Book the Van</a></nav>
  </div>
</header>
<script is:inline>
(()=>{
const h=document.getElementById('siteHeader'),b=document.getElementById('menuButton'),n=document.getElementById('nav'),more=n?.querySelector('details');
const closeMenu=()=>{n?.classList.remove('open');b?.setAttribute('aria-expanded','false');b?.setAttribute('aria-label','Open menu');document.body.classList.remove('menu-open');if(more)more.open=false};
b?.addEventListener('click',()=>{const open=n?.classList.toggle('open');b.setAttribute('aria-expanded',String(Boolean(open)));b.setAttribute('aria-label',open?'Close menu':'Open menu');document.body.classList.toggle('menu-open',Boolean(open));});
n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
document.addEventListener('keydown',event=>{if(event.key!=='Escape')return;if(more?.open){more.open=false;more.querySelector('summary')?.focus()}else if(n?.classList.contains('open')){closeMenu();b?.focus()}});
document.addEventListener('click',event=>{if(!h?.contains(event.target))closeMenu()});
const s=()=>h?.classList.toggle('scrolled',scrollY>24);s();addEventListener('scroll',s,{passive:true});addEventListener('resize',()=>{if(innerWidth>900)closeMenu()});
})();
</script>
<style>
.header{position:fixed;inset:0 0 auto;z-index:50;border-bottom:1px solid transparent;transition:.25s}.header.scrolled{background:rgba(10,10,10,.97);border-color:#ffffff20;backdrop-filter:blur(15px)}
.bar{width:min(1420px,calc(100% - 42px));min-height:92px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:22px}.brand{width:126px;filter:drop-shadow(0 8px 18px #0006);flex:0 0 auto}.brand img{width:100%;height:auto}.header.scrolled .brand{width:110px}
nav{display:flex;align-items:center;gap:7px;padding:9px 12px;border:1px solid #ffffff30;border-radius:999px;background:#000c;box-shadow:0 8px 28px #0004;backdrop-filter:blur(10px)}nav a,summary{display:flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;color:#fff;font-size:.8rem;font-weight:900;letter-spacing:.035em;text-transform:uppercase;white-space:nowrap;line-height:1.2;border-radius:999px}nav a:hover,summary:hover{background:#ffffff20}nav a.active{background:#d71920}nav .book{padding:0 22px;background:var(--red);box-shadow:0 10px 25px #c9002250}nav .book:hover{background:#b90f17}
.more{position:relative}summary{cursor:pointer;list-style:none;gap:10px}summary::-webkit-details-marker{display:none}summary.more-active{color:#ff8b90}.more-links{position:absolute;top:calc(100% + 18px);right:0;width:230px;padding:10px;border:1px solid #ffffff30;border-radius:18px;background:#141414;box-shadow:0 18px 45px #0006}.more-links a{justify-content:flex-start;padding:14px;font-size:.78rem;white-space:normal;border-radius:10px}
.menu{display:none;width:46px;height:46px;border:0;border-radius:50%;background:var(--red);cursor:pointer}.menu span{display:block;width:20px;height:2px;margin:4px auto;background:#fff}
@media(max-width:1100px){nav a,summary{padding-inline:11px}.bar{gap:14px}.brand{width:110px}}
@media(max-width:900px){.bar{min-height:78px;width:calc(100% - 28px)}.brand,.header.scrolled .brand{width:100px}.menu{display:block}nav{display:none;position:absolute;top:92px;left:14px;right:14px;max-height:calc(100dvh - 108px);overflow:auto;padding:16px;flex-direction:column;align-items:stretch;gap:4px;background:#101010;border-radius:18px}nav.open{display:flex}nav a,summary{padding:14px;font-size:.9rem;min-height:48px}nav .book{margin-top:6px;padding:16px}.more-links{position:static;width:100%;margin:4px 0;padding:5px 10px;background:#222;box-shadow:none;border:0}.more-links a{justify-content:center;font-size:.85rem}summary{justify-content:center}}
</style>
