---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Vincenzo's Fish & Chips Van" description="Contact Vincenzo's Fish & Chips Van for public stops, events, weddings, gala days and private bookings.">
<section class="page-hero"><div class="container"><div class="kicker">Vincenzo & Giuliana</div><h1 class="page-title">Contact Us</h1><p class="lead">For events, weddings, care homes, gala days, corporate catering, public stops and private celebrations.</p></div></section>

<section class="section"><div class="container contact-grid">
<a class="card contact-card" href="tel:+447985522449"><span>Call or text</span><strong>07985 522 449</strong><small>Tap to call</small></a>
<a class="card contact-card" href="mailto:info@vincenzosfishandchips.com"><span>Email</span><strong>info@vincenzosfishandchips.com</strong><small>Send an enquiry</small></a>
<a class="card contact-card" href="https://www.facebook.com/VincenzosFishAndChipsVan/" target="_blank" rel="noopener"><span>Facebook</span><strong>Vincenzo’s Fish & Chips Van</strong><small>Message us and see live updates</small></a>
<a class="card contact-card" href="https://www.instagram.com/vincenzos_fishandchips/" target="_blank" rel="noopener"><span>Instagram</span><strong>@vincenzos_fishandchips</strong><small>Follow our latest photos and stories</small></a>
<a class="card contact-card" href="https://www.tiktok.com/@vincenzos_fishandchips" target="_blank" rel="noopener"><span>TikTok</span><strong>@vincenzos_fishandchips</strong><small>Watch the little black van on the road</small></a>
<a class="card contact-card" href="https://wa.me/447985522449" target="_blank" rel="noopener"><span>WhatsApp</span><strong>Message Vincenzo’s</strong><small>Open WhatsApp</small></a>
</div></section>

<section class="section section-cream"><div class="container form-layout"><div><div class="kicker">Send us a message</div><h2 class="section-title">How can we help?</h2><p class="lead">Complete the form and choose whether to send your message by e-mail or WhatsApp.</p></div>
<form id="contactForm" class="contact-form card" novalidate>
<div class="field-grid">
<label><span>Your name *</span><input id="contactName" type="text" autocomplete="name" required placeholder="Your full name"></label>
<label><span>Phone number</span><input id="contactPhone" type="tel" autocomplete="tel" placeholder="Your contact number"></label>
<label class="wide"><span>Email address *</span><input id="contactEmail" type="email" autocomplete="email" required placeholder="you@example.com"></label>
<label class="wide"><span>Subject *</span><select id="contactSubject" required><option value="">Choose a subject</option><option>Public stop / location</option><option>Event or booking enquiry</option><option>Care home enquiry</option><option>Press or media enquiry</option><option>General enquiry</option></select></label>
<label class="wide"><span>Your message *</span><textarea id="contactMessage" rows="7" required placeholder="Write your message here"></textarea></label>
</div>
<p id="contactError" class="form-error" role="alert" hidden>Please complete all fields marked with *.</p>
<div class="send-options"><button id="contactEmailSend" class="send-button email-button" type="button">Send by e-mail</button><button id="contactWhatsAppSend" class="send-button whatsapp-button" type="button">Send by WhatsApp</button></div>
<p class="form-privacy">Nothing is stored on this website. Your e-mail or WhatsApp app will open with the completed message ready to send.</p>
</form></div></section>

<section class="section"><div class="container grid-2"><div><div class="kicker">Our operational base</div><h2 class="section-title">11 Main Street, Cowie.</h2><p class="lead">This is where we prepare and support the little black van. It is not a walk-in fish & chip shop.</p><div class="notice"><strong>VAN ONLY</strong>For public service, please use the Find Us page and check Facebook before travelling.</div><div class="button-row"><a class="button button-red" href="/schedule">Find the van</a></div></div><div class="service-area card"><span>Serving</span><h3>Stirling District<br>Central Scotland<br>Events across Scotland</h3><p>Public village stops, private bookings, care homes, festivals and community events.</p></div></div></section>

<section class="section section-dark"><div class="container social"><div><div class="kicker">Follow the journey</div><h2 class="section-title">Keep up with the little black van.</h2></div><div class="social-links"><a href="https://www.facebook.com/VincenzosFishAndChipsVan/" target="_blank" rel="noopener">Facebook <span>→</span></a><a href="https://www.instagram.com/vincenzos_fishandchips/" target="_blank" rel="noopener">Instagram <span>→</span></a><a href="https://www.tiktok.com/@vincenzos_fishandchips" target="_blank" rel="noopener">TikTok <span>→</span></a><a href="https://wa.me/447985522449" target="_blank" rel="noopener">WhatsApp <span>→</span></a></div></div></section>

<script is:inline>
(()=>{const form=document.getElementById('contactForm'),error=document.getElementById('contactError');if(!form)return;const value=id=>document.getElementById(id)?.value.trim()||'';const ready=()=>{if(form.checkValidity()){error.hidden=true;return true}error.hidden=false;form.reportValidity();return false};const msg=()=>["CONTACT ENQUIRY — VINCENZO'S FISH & CHIPS VAN",'',`Name: ${value('contactName')}`,`Phone: ${value('contactPhone')||'Not provided'}`,`Email: ${value('contactEmail')}`,`Subject: ${value('contactSubject')}`,'','Message:',value('contactMessage')].join('\n');document.getElementById('contactEmailSend')?.addEventListener('click',()=>{if(!ready())return;location.href=`mailto:info@vincenzosfishandchips.com?subject=${encodeURIComponent(value('contactSubject'))}&body=${encodeURIComponent(msg())}`});document.getElementById('contactWhatsAppSend')?.addEventListener('click',()=>{if(!ready())return;window.open(`https://wa.me/447985522449?text=${encodeURIComponent(msg())}`,'_blank','noopener')})})();
</script>
</BaseLayout>
<style>
.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.contact-card{min-height:210px;padding:26px;display:flex;flex-direction:column;justify-content:space-between;transition:.2s}.contact-card:hover{transform:translateY(-4px)}.contact-card span{color:var(--red);font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.12em}.contact-card strong{font-size:1.22rem;overflow-wrap:anywhere}.contact-card small{color:var(--soft)}
.form-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;align-items:start}.contact-form{padding:30px}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.field-grid label{display:grid;gap:7px}.field-grid .wide{grid-column:1/-1}.field-grid label>span{font-size:.7rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.field-grid input,.field-grid select,.field-grid textarea{width:100%;padding:14px 15px;border:1px solid #d8d2ca;border-radius:12px;background:#fff;color:#171717}.field-grid input,.field-grid select{min-height:52px}.field-grid textarea{resize:vertical}.field-grid input:focus,.field-grid select:focus,.field-grid textarea:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(215,25,32,.1)}.form-error{margin-top:18px;padding:12px 14px;border-radius:10px;background:#fff0f0;color:#a80d13;font-weight:800}.send-options{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px}.send-button{min-height:57px;border:0;border-radius:999px;padding:14px 18px;color:#fff;font-weight:900;text-transform:uppercase;cursor:pointer}.email-button{background:var(--red)}.whatsapp-button{background:#168a45}.form-privacy{margin:15px 4px 0;color:#777;font-size:.76rem;line-height:1.5}
.service-area{display:flex;flex-direction:column;justify-content:center;padding:36px;background:#111;color:#fff}.service-area span{color:#ff5d63;font-size:.7rem;font-weight:900;text-transform:uppercase}.service-area h3{font-family:Georgia,serif;font-size:2.3rem;line-height:1.15}.service-area p{color:#aaa}.social{display:grid;grid-template-columns:1.3fr 1fr;gap:50px;align-items:end}.social-links{display:grid}.social-links a{display:flex;justify-content:space-between;padding:18px 0;border-bottom:1px solid #333;font-size:1.2rem;font-weight:900}.social-links span{color:#ff5d63}
@media(max-width:850px){.contact-grid{grid-template-columns:1fr 1fr}.form-layout,.social{grid-template-columns:1fr}}@media(max-width:560px){.contact-grid,.field-grid,.send-options{grid-template-columns:1fr}.field-grid .wide{grid-column:auto}.contact-form{padding:22px 16px}}
</style>
