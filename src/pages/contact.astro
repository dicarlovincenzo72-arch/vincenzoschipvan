<a class="card contact-card" href="https://www.tiktok.com/@vincenzos_fishandchips" target="_blank" rel="noopener"><span class="contact-label"><span class="contact-icon-wrap tiktok"><svg class="contact-icon" aria-hidden="true" focusable="false" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></span>TikTok</span><strong>@vincenzos_fishandchips</strong><small>Watch the little black van on the road</small></a>
<a class="card contact-card" href="https://wa.me/447985522449" target="_blank" rel="noopener"><span class="contact-label"><span class="contact-icon-wrap whatsapp"><svg class="contact-icon" aria-hidden="true" focusable="false" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></span>WhatsApp</span><strong>Message Vincenzo’s</strong><small>Open WhatsApp</small></a>
</div></section>

<section class="section section-cream"><div class="container form-layout"><div><div class="kicker">Send us a message</div><h2 class="section-title">How can we help?</h2><p class="lead">Complete the form and choose whether to send your message by e-mail or WhatsApp.</p></div>
<form id="contactForm" class="contact-form card" novalidate>
<div class="field-grid">
<label><span>Your name *</span><input id="contactName" type="text" autocomplete="name" required placeholder="Your full name"></label>
<label><span>Phone number</span><input id="contactPhone" type="tel" autocomplete="tel" placeholder="Your contact number"></label>
<label class="wide"><span>Email address *</span><input id="contactEmail" type="email" autocomplete="email" required placeholder="you@example.com"></label>
<label class="wide"><span>Subject *</span><select id="contactSubject" required><option value="">Choose a subject</option><option>Public stop / location</option><option>Event or booking enquiry</option><option>Care home enquiry</option><option>Press or media enquiry</option><option>General enquiry</option></select></label>
<label class="wide"><span>Your message *</span><textarea id="contactMessage" rows="7" required placeholder="Write your message here"></textarea></label>
</div>
<p id="contactError" class="form-error" role="alert" hidden>Please complete all fields marked with *.</p>
<div class="send-options"><button id="contactEmailSend" class="send-button email-button" type="button">Open e-mail draft</button><button id="contactWhatsAppSend" class="send-button whatsapp-button" type="button">Open WhatsApp draft</button></div>
<p class="form-privacy">Nothing is stored on this website. Your e-mail or WhatsApp app will open with the completed message ready to send. Review it and press Send in that app to complete your enquiry.</p>
</form></div></section>

<section class="section"><div class="container grid-2"><div><div class="kicker">Our operational base</div><h2 class="section-title">11 Main Street, Cowie.</h2><p class="lead">This is where we prepare and support the little black van. It is not a walk-in fish & chip shop.</p><div class="notice"><strong>VAN ONLY</strong>For public service, please use the Find Us page and check Facebook before travelling.</div><div class="button-row"><a class="button button-red" href="/schedule">Find the van</a></div></div><div class="service-area card"><span>Serving</span><h3>Stirling District<br>Central Scotland<br>Events across Scotland</h3><p>Public village stops, private bookings, care homes, festivals and community events.</p></div></div></section>

<section class="section section-dark"><div class="container social"><div><div class="kicker">Follow the journey</div><h2 class="section-title">Keep up with the little black van.</h2></div><div class="social-links"><a href="https://www.facebook.com/VincenzosFishAndChipsVan/" target="_blank" rel="noopener">Facebook <span>→</span></a><a href="https://www.instagram.com/vincenzos_fishandchips/" target="_blank" rel="noopener">Instagram <span>→</span></a><a href="https://www.tiktok.com/@vincenzos_fishandchips" target="_blank" rel="noopener">TikTok <span>→</span></a><a href="https://wa.me/447985522449" target="_blank" rel="noopener">WhatsApp <span>→</span></a></div></div></section>

<script is:inline>
(()=>{const form=document.getElementById('contactForm'),error=document.getElementById('contactError');if(!form)return;const value=id=>document.getElementById(id)?.value.trim()||'';const ready=()=>{if(form.checkValidity()){error.hidden=true;return true}error.hidden=false;form.reportValidity();return false};const msg=()=>["CONTACT ENQUIRY — VINCENZO'S FISH & CHIPS VAN",'',`Name: ${value('contactName')}`,`Phone: ${value('contactPhone')||'Not provided'}`,`Email: ${value('contactEmail')}`,`Subject: ${value('contactSubject')}`,'','Message:',value('contactMessage')].join('\n');document.getElementById('contactEmailSend')?.addEventListener('click',()=>{if(!ready())return;location.href=`mailto:info@vincenzosfishandchips.com?subject=${encodeURIComponent(value('contactSubject'))}&body=${encodeURIComponent(msg())}`});document.getElementById('contactWhatsAppSend')?.addEventListener('click',()=>{if(!ready())return;window.open(`https://wa.me/447985522449?text=${encodeURIComponent(msg())}`,'_blank','noopener')})})();
</script>
</BaseLayout>
<style>
.contact-label{display:flex;flex-direction:column;align-items:center;gap:12px}.contact-icon-wrap{display:grid;place-items:center;width:52px;height:52px;border-radius:14px;background:#fff0f0;color:var(--red)}.contact-icon{width:29px;height:29px}.contact-icon-wrap.facebook{background:#1877f210;color:#1877f2}.contact-icon-wrap.instagram{background:linear-gradient(135deg,#fff0da,#ffe5ef,#f0e9ff);color:#c13584}.contact-icon-wrap.tiktok{background:#111;color:#fff}.contact-icon-wrap.whatsapp{background:#e9f9ef;color:#168a45}.contact-icon-wrap :global(svg){fill:currentColor}.contact-icon-wrap.call-or-text :global(svg),.contact-icon-wrap.email :global(svg){fill:none}.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.contact-card{min-height:210px;padding:26px;display:flex;flex-direction:column;justify-content:space-between;transition:.2s}.contact-card:hover{transform:translateY(-4px)}.contact-card span{color:var(--red);font-size:.72rem;font-weight:900;text-transform:uppercase;letter-spacing:.12em}.contact-card strong{font-size:1.22rem;overflow-wrap:anywhere}.contact-card small{color:var(--soft)}
.form-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:50px;align-items:start}.contact-form{padding:30px}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.field-grid label{display:grid;gap:7px}.field-grid .wide{grid-column:1/-1}.field-grid label>span{font-size:.7rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.field-grid input,.field-grid select,.field-grid textarea{width:100%;padding:14px 15px;border:1px solid #d8d2ca;border-radius:12px;background:#fff;color:#171717}.field-grid input,.field-grid select{min-height:52px}.field-grid textarea{resize:vertical}.field-grid input:focus,.field-grid select:focus,.field-grid textarea:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(215,25,32,.1)}.form-error{margin-top:18px;padding:12px 14px;border-radius:10px;background:#fff0f0;color:var(--red-dark);font-weight:800}.send-options{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px}.send-button{min-height:57px;border:0;border-radius:999px;padding:14px 18px;color:#fff;font-weight:900;text-transform:uppercase;cursor:pointer}.email-button{background:var(--red)}.whatsapp-button{background:#168a45}.form-privacy{margin:15px 4px 0;color:#777;font-size:.76rem;line-height:1.5}
.service-area{display:flex;flex-direction:column;justify-content:center;padding:36px;background:#111;color:#fff}.service-area span{color:var(--red-on-dark);font-size:.7rem;font-weight:900;text-transform:uppercase}.service-area h3{font-family:Georgia,serif;font-size:2.3rem;line-height:1.15}.service-area p{color:#aaa}.social{display:grid;grid-template-columns:1.3fr 1fr;gap:50px;align-items:end}.social-links{display:grid}.social-links a{display:flex;justify-content:space-between;padding:18px 0;border-bottom:1px solid #333;font-size:1.2rem;font-weight:900}.social-links span{color:var(--red-on-dark)}
@media(max-width:850px){.contact-grid{grid-template-columns:1fr 1fr}.form-layout,.social{grid-template-columns:1fr}}@media(max-width:560px){.contact-grid,.field-grid,.send-options{grid-template-columns:1fr}.field-grid .wide{grid-column:auto}.contact-form{padding:22px 16px}}

/* Consistent centred section headings and information cards. */
.contact-card{align-items:center;text-align:center;gap:16px}.form-layout>div,.grid-2>div,.social>div:first-child{text-align:center}.form-layout .lead,.grid-2 .lead{margin-inline:auto}.service-area{text-align:center;align-items:center}.service-area h3{font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.2}.form-privacy{text-align:center}
</style>

