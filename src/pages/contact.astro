---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Vincenzo's Fish & Chips Van" description="Contact Vincenzo's Fish & Chips Van for public stops, events, weddings, gala days and private bookings.">
<section class="page-hero"><div class="container"><div class="kicker">Vincenzo & Giuliana</div><h1 class="page-title">Contact Us</h1><p class="lead">For events, weddings, care homes, gala days, corporate catering and private celebrations.</p></div></section>
<section class="section"><div class="container contact-grid"><a class="card contact-card" href="tel:+447985522449"><span>Call or text</span><strong>07985 522 449</strong><small>Tap to call</small></a><a class="card contact-card" href="mailto:info@vincenzosfishandchips.com"><span>Email</span><strong>info@vincenzosfishandchips.com</strong><small>Send an enquiry</small></a><a class="card contact-card" href="https://www.facebook.com/VincenzosFishAndChipsVan/" target="_blank" rel="noopener"><span>Facebook</span><strong>Vincenzo’s Fish & Chips Van</strong><small>Message us and see live updates</small></a></div></section>
<section class="section section-cream"><div class="container grid-2"><div><div class="kicker">Our operational base</div><h2 class="section-title">11 Main Street, Cowie.</h2><p class="lead">This is where we prepare and support the little black van. It is not a walk-in fish & chip shop.</p><div class="notice"><strong>VAN ONLY</strong>For public service, please use the Find Us page and check Facebook before travelling.</div><div class="button-row"><a class="button button-red" href="/schedule">Find the van</a></div></div><div class="service-area card"><span>Serving</span><h3>Stirling District<br>Central Scotland<br>Events across Scotland</h3><p>Public village stops, private bookings, care homes, festivals and community events.</p></div></div></section>
<section class="section section-dark"><div class="container social"><div><div class="kicker">Follow the journey</div><h2 class="section-title">Keep up with the little black van.</h2></div><div class="social-links"><a href="https://www.facebook.com/VincenzosFishAndChipsVan/" target="_blank" rel="noopener">Facebook <span>→</span></a><a href="https://www.instagram.com/vincenzos_fishandchips/" target="_blank" rel="noopener">Instagram <span>→</span></a><a href="https://www.tiktok.com/@vincenzos_fishandchips" target="_blank" rel="noopener">TikTok <span>→</span></a></div></div></section>
</BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.contact-card{min-height:220px;padding:26px;display:flex;flex-direction:column;justify-content:space-between}.contact-card span{color:var(--red);font-size:.7rem;font-weight:900;text-transform:uppercase;letter-spacing:.12em}.contact-card strong{font-size:1.28rem;overflow-wrap:anywhere}.contact-card small{color:var(--soft)}.service-area{display:flex;flex-direction:column;justify-content:center;padding:36px;background:#111;color:#fff}.service-area span{color:#ff5d63;font-size:.7rem;font-weight:900;text-transform:uppercase}.service-area h3{font-family:Georgia,serif;font-size:2.3rem;line-height:1.15}.service-area p{color:#aaa}.social{display:grid;grid-template-columns:1.3fr 1fr;gap:50px;align-items:end}.social-links{display:grid}.social-links a{display:flex;justify-content:space-between;padding:18px 0;border-bottom:1px solid #333;font-size:1.2rem;font-weight:900}.social-links span{color:#ff5d63}@media(max-width:800px){.contact-grid,.social{grid-template-columns:1fr}}
</style>
