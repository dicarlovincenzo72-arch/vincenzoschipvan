---
import BaseLayout from '../layouts/BaseLayout.astro';
import {eventTypes} from '../data/site';
---
<BaseLayout title="Event Catering | Vincenzo's Fish & Chips Van" description="Book Vincenzo's multi award-winning Fish & Chips Van for weddings, gala days, Highland Games, corporate events and private celebrations across Scotland.">
<section class="page-hero"><div class="container"><div class="kicker">Book the little black van</div><h1 class="page-title">Make your event unforgettable.</h1><p class="lead">Multi award-winning fish and chips, cooked fresh on site and served with the personality and warmth your guests will remember.</p></div></section>
<section class="section"><div class="container grid-2 event-intro"><div><div class="kicker">All across Scotland</div><h2 class="section-title">One van. Countless events.</h2><p class="lead">Popular dates fill quickly, so contact us as early as possible. Event bookings normally require a minimum of 50 guests or the equivalent guaranteed order.</p><div class="button-row"><a class="button button-red" href="mailto:info@vincenzosfishandchips.com?subject=Event%20Enquiry">Email an enquiry</a><a class="button button-dark" href="tel:+447985522449">Call or text us</a></div></div><img src="/assets/images/press/van-queue.jpg" alt="The little black van serving a busy real event" loading="lazy"></div></section>
<section class="section section-cream"><div class="container"><div class="kicker">What we cater for</div><h2 class="section-title">From intimate celebrations to major community days.</h2><div class="event-grid">{eventTypes.map((type,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{type}</h3></article>)}</div></div></section>
<section class="section"><div class="container grid-2"><div><div class="kicker">What to include</div><h2 class="section-title">Tell us about your day.</h2><p class="lead">For a quick and accurate reply, please include:</p><ul class="checklist"><li>Event date and preferred serving time</li><li>Venue, town and postcode</li><li>Type of event</li><li>Estimated number of guests</li><li>Parking and access details for the van</li><li>Your name and contact number</li></ul></div><div class="enquiry card"><img src="/assets/images/press/van-launch.jpg" alt="Vincenzo's Fish & Chips Van" loading="lazy"><div><span>Contact Vincenzo & Giuliana</span><a href="tel:+447985522449">07985 522 449</a><a href="mailto:info@vincenzosfishandchips.com">info@vincenzosfishandchips.com</a><p>Cash and card payments accepted. Care-home visits are normally arranged Monday to Thursday.</p></div></div></div></section>
</BaseLayout>
<style>.event-intro img{width:100%;height:500px;object-fit:cover;border-radius:28px}.event-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:44px}.event-grid article{min-height:165px;padding:22px;border:1px solid var(--line);border-radius:19px;background:#fff}.event-grid span{color:var(--red);font-size:.68rem;font-weight:900}.event-grid h3{margin:35px 0 0;font-family:Georgia,serif;font-size:1.45rem;line-height:1.1}.checklist{display:grid;gap:12px;margin:28px 0 0;padding:0;list-style:none}.checklist li{padding:15px 18px 15px 48px;border-radius:13px;background:var(--cream);position:relative}.checklist li:before{content:'✓';position:absolute;left:18px;color:var(--red);font-weight:900}.enquiry img{width:100%;height:290px;object-fit:cover}.enquiry div{display:grid;gap:10px;padding:25px}.enquiry span{color:var(--red);font-size:.7rem;font-weight:900;text-transform:uppercase}.enquiry a{font-size:1.18rem;font-weight:900;overflow-wrap:anywhere}.enquiry p{color:var(--soft)}@media(max-width:900px){.event-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:550px){.event-grid{grid-template-columns:1fr}.event-intro img{height:350px}}
</style>
