---
import BaseLayout from '../layouts/BaseLayout.astro';
import {eventTypes} from '../data/site';
---
<BaseLayout title="Event Catering | Vincenzo's Fish & Chips Van" description="Book Vincenzo's multi award-winning Fish & Chips Van for weddings, gala days, Highland Games, corporate events and private celebrations across Scotland.">
  <section class="page-hero event-hero"><div class="container"><div class="kicker">Bring the little black van to your event</div><h1 class="page-title">Freshly cooked.<br>Unforgettable.</h1><p class="lead">From weddings and private celebrations to Highland Games, gala days and major community events, Vincenzo, Giuliana and the little black van bring multi award-winning fish and chips — cooked fresh on site and served with a warm Italian-Scottish welcome.</p></div></section>

  <section class="section"><div class="container grid-2 event-intro"><div><div class="kicker">A real experience for your guests</div><h2 class="section-title">More than event catering.</h2><p class="lead">The little black van becomes part of your day. Your guests see their food cooked fresh, enjoy generous chip-shop favourites and receive the friendly, personal service that has made Vincenzo’s a familiar name across Central Scotland.</p><p class="body-copy">We cater across Scotland for weddings, birthdays, corporate events, care homes, festivals, charity fundraisers, shows and community celebrations. Our diesel van operates with the engine switched off during service. Its advanced electrical system uses two batteries to provide around 8–10 hours of autonomy, so there is no engine noise while we serve. We arrive prepared and keep serving with a smile until the last customer in the queue.</p><div class="event-note"><strong>Plan early</strong><span>Popular dates book quickly. Private event bookings normally require at least 50 guests or the equivalent guaranteed order. Care-home visits are normally arranged Monday to Thursday.</span></div></div><img src="/assets/images/community/bowhill-serving.jpg" alt="Freshly cooked fish and chips being served at Bowhill Highland Games" loading="lazy"></div></section>

  <section class="section section-cream"><div class="container"><div class="kicker">Perfect for</div><h2 class="section-title">Your event, your guests, our little black van.</h2><div class="event-grid">{eventTypes.map((type,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{type}</h3></article>)}</div></div></section>

  <section class="section form-section" id="event-enquiry"><div class="container form-layout"><div class="form-copy"><div class="kicker">Request your date</div><h2 class="section-title">Tell us about your event.</h2><p class="lead">Complete the form once, then choose whether to send it by e-mail or WhatsApp. Your message will be prepared automatically with all the information we need to check availability.</p><ul class="checklist"><li>Your preferred date and serving time</li><li>Venue, town and postcode</li><li>Type of event and estimated guests</li><li>Parking or access information for the van</li></ul><div class="direct-contact"><span>Prefer to speak to us?</span><a href="tel:+447985522449">07985 522 449</a><a href="mailto:info@vincenzosfishandchips.com">info@vincenzosfishandchips.com</a></div></div>

    <form id="eventForm" class="event-form card" novalidate>
      <div class="form-title"><span>Event enquiry</span><strong>Vincenzo’s Fish & Chips Van</strong></div>
      <div class="field-grid">
        <label><span>Your name *</span><input id="enquiryName" name="name" type="text" autocomplete="name" required placeholder="Your full name"></label>
        <label><span>Phone number *</span><input id="enquiryPhone" name="phone" type="tel" autocomplete="tel" required placeholder="Your contact number"></label>
        <label class="wide"><span>E-mail address</span><input id="enquiryEmail" name="email" type="email" autocomplete="email" placeholder="you@example.com"></label>
        <label class="wide"><span>Type of event *</span><select id="enquiryType" name="eventType" required><option value="">Select your event</option>{eventTypes.map(type=><option value={type}>{type}</option>)}<option value="Other event">Other event</option></select></label>
        <label><span>Event date (DD/MM/YYYY) *</span><input id="enquiryDate" name="date" type="text" inputmode="numeric" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" placeholder="DD/MM/YYYY" title="Enter the date as DD/MM/YYYY, for example 30/09/2026" required></label>
        <label><span>Serving time *</span><input id="enquiryTime" name="time" type="time" required></label>
        <label class="wide"><span>Venue / location *</span><input id="enquiryVenue" name="venue" type="text" required placeholder="Venue name, town and address"></label>
        <label><span>Postcode</span><input id="enquiryPostcode" name="postcode" type="text" autocomplete="postal-code" placeholder="Postcode"></label>
        <label><span>Estimated guests *</span><input id="enquiryGuests" name="guests" type="number" min="1" required placeholder="Number of guests"></label>
        <label class="wide"><span>Anything else we should know?</span><textarea id="enquiryDetails" name="details" rows="5" placeholder="Parking, access, serving plans or any other useful details"></textarea></label>
      </div>
      <p id="formError" class="form-error" role="alert" hidden>Please complete all fields marked with *.</p>
      <div class="send-options"><button id="sendEmail" class="send-button email-button" type="button"><span aria-hidden="true">✉</span> Open e-mail draft</button><button id="sendWhatsApp" class="send-button whatsapp-button" type="button"><span aria-hidden="true">◉</span> Open WhatsApp draft</button></div>
      <p class="form-privacy">Nothing is stored on this website. Your chosen e-mail or WhatsApp app will open with the completed request ready to send. Review it and press Send in that app to complete your enquiry.</p>
    </form>
  </div></section>

  <script is:inline>
    (()=>{const form=document.getElementById('eventForm'),error=document.getElementById('formError');if(!form)return;const value=id=>document.getElementById(id)?.value.trim()||'';const buildMessage=()=>["EVENT ENQUIRY — VINCENZO'S FISH & CHIPS VAN",'',`Name: ${value('enquiryName')}`,`Phone: ${value('enquiryPhone')}`,`Email: ${value('enquiryEmail')||'Not provided'}`,`Event type: ${value('enquiryType')}`,`Event date: ${value('enquiryDate')}`,`Preferred serving time: ${value('enquiryTime')}`,`Venue / location: ${value('enquiryVenue')}`,`Postcode: ${value('enquiryPostcode')||'Not provided'}`,`Estimated guests: ${value('enquiryGuests')}`,'','Additional information:',value('enquiryDetails')||'None provided'].join('\n');const dateInput=document.getElementById('enquiryDate');const validateDate=()=>{const match=dateInput.value.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);let valid=false;if(match){const day=Number(match[1]),month=Number(match[2]),year=Number(match[3]),date=new Date(0);date.setFullYear(year,month-1,day);valid=year>=1000&&date.getFullYear()===year&&date.getMonth()===month-1&&date.getDate()===day}dateInput.setCustomValidity(valid?'':'Enter a valid date in DD/MM/YYYY format, for example 30/09/2026.')};dateInput.addEventListener('input',()=>dateInput.setCustomValidity(''));const ready=()=>{validateDate();if(form.checkValidity()){error.hidden=true;return true}error.hidden=false;form.reportValidity();return false};document.getElementById('sendEmail')?.addEventListener('click',()=>{if(!ready())return;const subject=`Event Enquiry — ${value('enquiryType')} — ${value('enquiryDate')}`;location.href=`mailto:info@vincenzosfishandchips.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(buildMessage())}`});document.getElementById('sendWhatsApp')?.addEventListener('click',()=>{if(!ready())return;window.open(`https://wa.me/447985522449?text=${encodeURIComponent(buildMessage())}`,'_blank','noopener')})})();
  </script>
</BaseLayout>

<style>
@media(min-width:901px){.event-hero:after{background:linear-gradient(90deg,#151515 0%,#151515 49%,rgba(21,21,21,0) 54%)}}

.event-hero{display:flex;align-items:center}.event-hero .container{width:50%;margin-inline:0;padding-inline:clamp(24px,4.5vw,72px);text-align:center}.event-hero .page-title{max-width:100%;font-size:clamp(2.6rem,4.2vw,4.5rem)}.event-hero .lead{max-width:100%;margin:22px auto 0;font-size:clamp(1rem,1.25vw,1.15rem)}@media(max-width:900px){.event-hero .container{width:min(1180px,calc(100% - 36px));margin-inline:auto;padding-inline:0}.event-hero .page-title{font-size:clamp(2.6rem,7vw,4.5rem)}}.event-intro{align-items:center;gap:50px}.event-intro img{width:100%;height:600px;object-fit:cover;border-radius:28px}.body-copy{max-width:720px;margin-top:20px;color:var(--soft);font-size:1.05rem;line-height:1.75}.event-note{display:grid;gap:7px;margin-top:28px;padding:20px 22px;border-left:5px solid var(--red);background:var(--cream)}.event-note strong{font-size:.74rem;letter-spacing:.12em;text-transform:uppercase}.event-note span{color:var(--soft)}.event-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:44px}.event-grid article{min-height:165px;padding:22px;border:1px solid var(--line);border-radius:19px;background:#fff}.event-grid span{color:var(--red);font-size:.68rem;font-weight:900}.event-grid h3{margin:35px 0 0;font-family:Georgia,serif;font-size:1.45rem;line-height:1.1}.form-section{background:#fff}.form-layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(520px,1.2fr);gap:55px;align-items:start}.form-copy{position:sticky;top:120px}.checklist{display:grid;gap:10px;margin:28px 0 0;padding:0;list-style:none}.checklist li{padding:14px 16px 14px 45px;border-radius:13px;background:var(--cream);position:relative}.checklist li:before{content:'✓';position:absolute;left:17px;color:var(--red);font-weight:900}.direct-contact{display:grid;gap:7px;margin-top:28px}.direct-contact span{color:var(--red);font-size:.68rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.direct-contact a{font-weight:900;overflow-wrap:anywhere}.event-form{padding:30px}.form-title{display:grid;gap:5px;margin-bottom:26px;padding-bottom:20px;border-bottom:1px solid var(--line)}.form-title span{color:var(--red);font-size:.67rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.form-title strong{font-family:Georgia,serif;font-size:1.65rem}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.field-grid label{display:grid;gap:7px}.field-grid label.wide{grid-column:1/-1}.field-grid label>span{font-size:.7rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.field-grid input,.field-grid select,.field-grid textarea{width:100%;border:1px solid #d8d2ca;border-radius:12px;background:#fff;padding:14px 15px;color:#171717;outline:none}.field-grid input,.field-grid select{min-height:52px}.field-grid textarea{resize:vertical}.field-grid input:focus,.field-grid select:focus,.field-grid textarea:focus{border-color:var(--red);box-shadow:0 0 0 3px rgba(215,25,32,.1)}.form-error{margin:18px 0 0;padding:12px 14px;border-radius:10px;background:#fff0f0;color:var(--red-dark);font-weight:800}.send-options{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px}.send-button{min-height:57px;border:0;border-radius:999px;padding:14px 18px;color:#fff;font-size:.74rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase;cursor:pointer}.email-button{background:var(--red)}.whatsapp-button{background:#168a45}.send-button:hover{filter:brightness(.93);transform:translateY(-1px)}.send-button span{margin-right:6px;font-size:1rem}.form-privacy{margin:15px 4px 0;color:#777;font-size:.76rem;line-height:1.5}@media(max-width:950px){.event-grid{grid-template-columns:repeat(2,1fr)}.form-layout{grid-template-columns:1fr}.form-copy{position:static}.event-intro{gap:24px}}@media(max-width:550px){.event-grid{grid-template-columns:1fr}.event-intro img{height:360px}.event-form{padding:22px 16px}.field-grid,.send-options{grid-template-columns:1fr}.field-grid label.wide{grid-column:auto}}

/* Consistent centred section headings and information cards. */
.event-intro>div,.form-copy,.form-title,.direct-contact{text-align:center}.event-intro .lead,.event-intro .body-copy,.form-copy .lead{margin-inline:auto}.event-grid article{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:165px}.event-grid h3{margin:16px 0 0;text-wrap:balance}.event-note{text-align:center}.checklist{text-align:left}.form-privacy{text-align:center}
</style>

