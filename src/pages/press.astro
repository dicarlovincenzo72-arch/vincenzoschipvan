1fr 44px;gap:46px;padding:0 0 48px}.timeline li:before{content:'';position:absolute;left:106px;top:7px;width:15px;height:15px;border:4px solid #fff;border-radius:50%;background:#d71920;box-shadow:0 0 0 1px #d71920}.timeline li.parliament:before{background:#d9ad55;box-shadow:0 0 0 1px #b68a35}.year{padding-top:2px;color:#999;font-family:Georgia,serif;font-size:1.15rem}.timeline article{padding-bottom:42px;border-bottom:1px solid #e7e1d8}.meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:13px;color:#777;font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.meta span:before{content:'•';margin-right:10px;color:#d71920}.meta .type{padding:5px 8px;border-radius:999px;background:#f6f1e8;color:#7d6651}.meta .type:before{display:none}.timeline h3{max-width:900px;margin:0;font-family:Georgia,serif;font-size:clamp(1.65rem,3vw,2.5rem);font-weight:400;line-height:1.08}.timeline p{max-width:820px;margin:14px 0 0;color:#686868;line-height:1.65}.number{color:#c8c0b6;font-size:.7rem;font-weight:900;letter-spacing:.1em}.press-contact{display:flex;align-items:center;justify-content:space-between;gap:24px}.press-contact h2{margin:0;font-family:Georgia,serif;font-size:clamp(2rem,4vw,3.5rem)}
@media(max-width:900px){.archive-count{position:static;width:max-content;margin-top:36px}.parliament-head,.archive-heading{grid-template-columns:1fr}.parliament-grid{grid-template-columns:1fr}.timeline:before{left:77px}.timeline li{grid-template-columns:58px 1fr;gap:38px}.timeline li:before{left:70px}.number{display:none}}
@media(max-width:600px){.archive-count strong{font-size:2.8rem}.timeline:before{left:7px}.timeline li{display:block;padding-left:31px}.timeline li:before{left:0}.year{margin-bottom:9px}.meta{align-items:flex-start}.press-contact{flex-direction:column;text-align:center}.parliament-grid article{padding:25px}}
</style>
