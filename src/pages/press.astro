<BaseLayout title="Press & Scottish Parliament | Vincenzo's® Fish & Chips Van" description="The complete chronological press archive for Vincenzo's Fish & Chips, including newspaper coverage, television, awards and Scottish Parliament recognition.">
  <section class="page-hero press-hero"><div class="container"><div class="kicker">Our documented journey</div><h1 class="page-title">Press & Recognition</h1><p class="lead">Newspapers, television, awards and two Scottish Parliament motions — every verified publication, presented chronologically.</p><div class="archive-count"><strong>{stories.length}</strong><span>verified publications<br>2023–2026</span></div></div></section>

  <section class="parliament-section"><div class="container"><div class="parliament-head"><div><div class="kicker">Official recognition</div><h2>Recognised twice by the Scottish Parliament.</h2></div><p>Two motions were lodged by Evelyn Tweed MSP in recognition of Vincenzo’s® charitable fundraising in Stirling.</p></div><div class="parliament-grid">{stories.filter(s=>s.type==='Parliament').map(story=><article><div class="motion-ref">{story.ref}</div><time datetime={story.date}>{story.display}</time><h3>{story.title}</h3><p>{story.copy}</p><a href={story.url} target="_blank" rel="noopener">Open official Parliament record →</a></article>)}</div></div></section>

  <section class="section archive"><div class="container"><div class="archive-heading"><div><div class="kicker">Complete archive</div><h2>From our first awards shortlist to the little black van.</h2></div><p>Oldest to newest. Each item links directly to the original publisher or official record.</p></div><ol class="timeline">{stories.map((story,i)=><li class:list={{parliament:story.type==='Parliament'}}><div class="year">{story.date.slice(0,4)}</div><article><div class="meta"><time datetime={story.date}>{story.display}</time><span>{story.source}</span><span class="type">{story.type}</span></div><h3>{story.title}</h3><p>{story.copy}</p><a href={story.url} target="_blank" rel="noopener">Read original publication <span aria-hidden="true">↗</span></a></article><div class="number">{String(i+1).padStart(2,'0')}</div></li>)}</ol></div></section>

  <section class="section-tight section-dark"><div class="container press-contact"><div><div class="kicker">Media enquiries</div><h2>Would you like to feature our story?</h2></div><a class="button button-red" href="mailto:info@vincenzosfishandchips.com?subject=Media%20Enquiry">Contact Vincenzo’s®</a></div></section>
</BaseLayout>
<style>
