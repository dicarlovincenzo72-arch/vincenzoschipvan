---
import BaseLayout from '../layouts/BaseLayout.astro';
import {schedule} from '../data/site';
---
<BaseLayout title="Find Us | Vincenzo's Fish & Chips Van" description="See today's locations and serving times for Vincenzo's Fish & Chips Van.">
<section class="page-hero"><div class="container"><div class="kicker">Today's locations</div><h1 class="page-title">Find the little black van.</h1><p class="lead">Our locations are decided and announced day by day. Choose a day and always check our latest Facebook poster before travelling.</p></div></section>
<section class="section"><div class="container"><div class="live-alert"><span>Live changes</span><strong>Facebook is the final same-day update.</strong><a href="https://www.facebook.com/VincenzosFishAndChipsVan/" target="_blank" rel="noopener">Check Facebook now →</a></div><div class="schedule-box"><div class="day-tabs" id="dayTabs">{schedule.map((day,i)=><button type="button" data-day={i}>{day.name.slice(0,3)}</button>)}</div>{schedule.map((day,i)=><section class="day-panel" data-panel={i}><div class="day-heading"><span>{String(i+1).padStart(2,'0')}</span><h2>{day.name}</h2></div><div class="stops">{day.stops.map((stop,n)=><article><span class="stop-number">Stop {n+1}</span><h3>{stop[0]}</h3><strong>{stop[1]}</strong></article>)}</div></section>)}</div><div class="notice"><strong>If you are in the queue, we will serve you.</strong>We cook fresh to order and often remain on site until the last customer has been served.</div></div></section>
<script is:inline>const tabs=[...document.querySelectorAll('[data-day]')],panels=[...document.querySelectorAll('[data-panel]')],native=new Date().getDay(),today=native===0?6:native-1;function show(i){tabs.forEach((t,n)=>t.classList.toggle('active',n===i));panels.forEach((p,n)=>p.hidden=n!==i)}tabs.forEach((tab,i)=>tab.addEventListener('click',()=>show(i)));show(today);</script>
</BaseLayout>
<style>.live-alert{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;margin-bottom:18px;padding:18px 22px;border-radius:18px;background:#111;color:#fff}.live-alert span{padding:7px 10px;border-radius:999px;background:var(--red);font-size:.65rem;font-weight:900;text-transform:uppercase}.live-alert a{font-weight:900}.schedule-box{padding:30px;border:1px solid var(--line);border-radius:28px;background:var(--cream);box-shadow:var(--shadow)}.day-tabs{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-bottom:34px}.day-tabs button{padding:14px 8px;border:1px solid var(--line);border-radius:999px;background:#fff;font-weight:900;cursor:pointer}.day-tabs button.active{border-color:var(--red);background:var(--red);color:#fff}.day-heading{display:flex;align-items:center;justify-content:center;gap:15px;margin-bottom:22px}.day-heading span{color:var(--red);font-size:.72rem;font-weight:900}.day-heading h2{margin:0;font-family:Georgia,serif;font-size:clamp(2.4rem,5vw,4rem)}.stops{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:920px;margin:auto}.stops article{min-height:175px;padding:24px;border:1px solid var(--line);border-radius:19px;background:#fff}.stop-number{color:#888;font-size:.67rem;font-weight:900;text-transform:uppercase}.stops h3{margin:18px 0 9px;font-size:1.3rem}.stops strong{color:var(--red)}.notice{max-width:920px;margin:24px auto 0}.notice strong{display:block}@media(max-width:720px){.live-alert{grid-template-columns:1fr;text-align:center}.day-tabs{grid-template-columns:repeat(4,1fr)}.schedule-box{padding:20px 13px}.stops{grid-template-columns:1fr}}
</style>
