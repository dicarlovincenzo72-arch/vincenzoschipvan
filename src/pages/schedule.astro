---
import BaseLayout from '../layouts/BaseLayout.astro';
import {schedule} from '../data/site';
import 'leaflet/dist/leaflet.css';
---
<BaseLayout title="Find Us | Vincenzo's Fish & Chips Van" description="See today's locations and serving times for Vincenzo's Fish & Chips Van.">
<section class="page-hero"><div class="container"><div class="kicker">Today's locations</div><h1 class="page-title">Find the little black van.</h1><p class="lead">Our locations are decided and announced day by day. Choose a day and always check our latest Facebook poster before travelling.</p></div></section>
<section class="section"><div class="container"><div class="live-alert"><span>Live changes</span><strong>Facebook is the final same-day update.</strong><a href="https://www.facebook.com/VincenzosFishAndChipsVan/" target="_blank" rel="noopener">Check Facebook now →</a></div><section class="van-live" id="vanLive"><div class="van-live-head"><div><span class="live-dot" aria-hidden="true"></span><strong id="vanLiveTitle">Live van location</strong></div><span id="vanLiveTime">Checking…</span></div><button class="map-close" id="vanClose" type="button" hidden aria-label="Close large map">Close ×</button><div class="van-offline" id="vanOffline"><strong>The little black van is not sharing its location right now.</strong><span>Live tracking appears here only while we are in service.</span></div><div id="vanMap" role="img" aria-label="Live location of Vincenzo's Fish & Chips Van" hidden></div><div class="map-actions"><button class="map-expand" id="vanExpand" type="button" hidden aria-expanded="false">View larger live map with the van →</button><a class="map-link" id="vanMapLink" target="_blank" rel="noopener" hidden>Directions in Google Maps ↗</a></div></section><div class="schedule-box"><div class="day-tabs" id="dayTabs">{schedule.map((day,i)=><button type="button" data-day={i}>{day.name.slice(0,3)}</button>)}</div>{schedule.map((day,i)=><section class="day-panel" data-panel={i}><div class="day-heading"><span>{String(i+1).padStart(2,'0')}</span><h2>{day.name}</h2></div><div class="stops">{day.stops.map((stop,n)=><article><span class="stop-number">Stop {n+1}</span><h3>{stop[0]}</h3><strong>{stop[1]}</strong></article>)}</div></section>)}</div><div class="notice"><strong>If you are in the queue, we will serve you.</strong>We cook fresh to order and often remain on site until the last customer has been served.</div></div></section>
<script is:inline>const tabs=[...document.querySelectorAll('[data-day]')],panels=[...document.querySelectorAll('[data-panel]')],native=new Date().getDay(),today=native===0?6:native-1;function show(i){tabs.forEach((t,n)=>t.classList.toggle('active',n===i));panels.forEach((p,n)=>p.hidden=n!==i)}tabs.forEach((tab,i)=>tab.addEventListener('click',()=>show(i)));show(today);</script>
<script>
import L from 'leaflet';
const liveCard=document.getElementById('vanLive'),liveTitle=document.getElementById('vanLiveTitle'),liveTime=document.getElementById('vanLiveTime'),offline=document.getElementById('vanOffline'),map=document.getElementById('vanMap'),mapLink=document.getElementById('vanMapLink'),expand=document.getElementById('vanExpand'),close=document.getElementById('vanClose');
let vanMap,vanMarker;
const vanIcon=L.icon({iconUrl:'/assets/images/van-map-marker.webp',iconSize:[110,49],iconAnchor:[55,47],popupAnchor:[0,-45]});
function closeLargeMap(){liveCard.classList.remove('expanded');document.body.style.overflow='';close.hidden=true;expand.hidden=map.hidden;expand.setAttribute('aria-expanded','false');requestAnimationFrame(()=>vanMap?.invalidateSize())}
expand.addEventListener('click',()=>{liveCard.classList.add('expanded');document.body.style.overflow='hidden';expand.hidden=true;expand.setAttribute('aria-expanded','true');close.hidden=false;requestAnimationFrame(()=>vanMap?.invalidateSize());close.focus()});
close.addEventListener('click',()=>{closeLargeMap();expand.focus()});
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&liveCard.classList.contains('expanded'))closeLargeMap()});
async function refreshVanLocation(){
  try{
    const response=await fetch('https://vincenzos-van-live.dicarlo-vincenzo72.chatgpt.site/api/location',{cache:'no-store'});
    if(!response.ok)throw new Error('Location unavailable');
    const location=await response.json();
    if(!location.live){liveTitle.textContent='Live van location';liveTime.textContent='Not active';offline.hidden=false;map.hidden=true;mapLink.hidden=true;expand.hidden=true;if(liveCard.classList.contains('expanded'))closeLargeMap();return}
    const lat=Number(location.latitude),lng=Number(location.longitude);
    if(!Number.isFinite(lat)||!Number.isFinite(lng)||Math.abs(lat)>90||Math.abs(lng)>180)throw new Error('Invalid location');
    const point=location.latitude+','+location.longitude;
    liveTitle.textContent='The little black van is live now';
    liveTime.textContent='Updated '+new Date(location.updatedAt).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
    offline.hidden=true;
    map.hidden=false;
    if(!liveCard.classList.contains('expanded'))expand.hidden=false;
    if(!vanMap){
      vanMap=L.map(map,{scrollWheelZoom:false}).setView([lat,lng],15);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{
        maxZoom:19,
        attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(vanMap);
      vanMarker=L.marker([lat,lng],{icon:vanIcon,title:"Vincenzo's little black van"}).addTo(vanMap);
      requestAnimationFrame(()=>vanMap.invalidateSize());
    }else{
      vanMarker.setLatLng([lat,lng]);
      vanMap.setView([lat,lng]);
      requestAnimationFrame(()=>vanMap.invalidateSize());
    }
    mapLink.href='https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent(point);
    mapLink.hidden=false;
  }catch{liveTime.textContent='Temporarily unavailable';offline.hidden=false;map.hidden=true;mapLink.hidden=true;expand.hidden=true;if(liveCard.classList.contains('expanded'))closeLargeMap()}
}
refreshVanLocation();setInterval(refreshVanLocation,20000);
</script>
</BaseLayout>
<style>.live-alert{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;margin-bottom:18px;padding:18px 22px;border-radius:18px;background:#111;color:#fff}.live-alert span{padding:7px 10px;border-radius:999px;background:var(--red);font-size:.65rem;font-weight:900;text-transform:uppercase}.live-alert a{font-weight:900}.schedule-box{padding:30px;border:1px solid var(--line);border-radius:28px;background:var(--cream);box-shadow:var(--shadow)}.day-tabs{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-bottom:34px}.day-tabs button{padding:14px 8px;border:1px solid var(--line);border-radius:999px;background:#fff;font-weight:900;cursor:pointer}.day-tabs button.active{border-color:var(--red);background:var(--red);color:#fff}.day-heading{display:flex;align-items:center;justify-content:center;gap:15px;margin-bottom:22px}.day-heading span{color:var(--red);font-size:.72rem;font-weight:900}.day-heading h2{margin:0;font-family:Georgia,serif;font-size:clamp(2.4rem,5vw,4rem)}.stops{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:920px;margin:auto}.stops article{min-height:175px;padding:24px;border:1px solid var(--line);border-radius:19px;background:#fff}.stop-number{color:#888;font-size:.67rem;font-weight:900;text-transform:uppercase}.stops h3{margin:18px 0 9px;font-size:1.3rem}.stops strong{color:var(--red)}.notice{max-width:920px;margin:24px auto 0}.notice strong{display:block}@media(max-width:720px){.live-alert{grid-template-columns:1fr;text-align:center}.day-tabs{grid-template-columns:repeat(4,1fr)}.schedule-box{padding:20px 13px}.stops{grid-template-columns:1fr}}
.van-live{margin:0 0 18px;padding:22px;border-radius:22px;background:#111;color:#fff;overflow:hidden}.van-live-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.van-live-head>div{display:flex;align-items:center;gap:10px}.van-live-head>span{color:#bbb;font-size:.8rem;font-weight:800}.live-dot{width:12px;height:12px;border-radius:50%;background:#e31b23;box-shadow:0 0 0 5px rgba(227,27,35,.18)}.van-offline{display:grid;gap:6px;padding:26px 18px;text-align:center;border:1px solid #333;border-radius:16px;background:#191919}.van-offline span{color:#bbb}.van-live #vanMap{display:block;width:100%;height:390px;border:0;border-radius:16px;background:#242424}.van-live #vanMap[hidden],.van-offline[hidden],.map-link[hidden],.map-expand[hidden],.map-close[hidden]{display:none}.map-actions{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin-top:14px}.map-expand,.map-close{border:0;background:none;color:#fff;font:inherit;font-weight:900;cursor:pointer}.map-link{color:#fff;font-weight:900}.van-live.expanded{position:fixed;inset:0;z-index:1000;display:flex;flex-direction:column;margin:0;border-radius:0;padding:22px}.van-live.expanded .van-live-head{padding-right:80px}.van-live.expanded #vanMap{flex:1;min-height:0;height:auto}.map-close{position:absolute;right:22px;top:20px}.van-live.expanded .map-actions{padding-bottom:env(safe-area-inset-bottom)}@media(max-width:720px){.van-live{padding:15px}.van-live-head{align-items:flex-start;flex-direction:column}.van-live #vanMap{height:340px}.van-live.expanded{padding:16px}.map-close{right:16px;top:16px}}
</style>
