---
import BaseLayout from '../layouts/BaseLayout.astro';
import {menuSections} from '../data/site';
---
<BaseLayout title="Menu | Vincenzo's Fish & Chips Van" description="Traditional fish and chips, suppers, kids meals and sides freshly cooked by Vincenzo's Fish & Chips Van.">
<section class="page-hero"><div class="container"><div class="kicker">Freshly cooked to order</div><h1 class="page-title">Our Menu</h1><p class="lead">Traditional chip-shop favourites, generous portions and the unmistakable taste of food cooked in beef dripping.</p></div></section>
<section class="section"><div class="container menu-grid">{menuSections.map((section,i)=><article class="menu-section card"><div class="menu-head"><span>{String(i+1).padStart(2,'0')}</span><h2>{section.name}</h2></div><div class="price-head"><span>Item</span>{section.columns.map(column=><strong>{column}</strong>)}</div><ul>{section.items.map(item=><li style={`--prices:${section.columns.length}`}><span>{item[0]}</span>{item.slice(1).map(price=><strong>{price}</strong>)}</li>)}</ul></article>)}</div></section>
<section class="section section-dark"><div class="container"><div class="kicker">Important dietary information</div><h2 class="section-title">Please ask before ordering.</h2><div class="diet-grid"><article><strong>Beef dripping</strong><p>Our fryers use traditional beef dripping. Chips and fried products are therefore not vegan or vegetarian.</p></article><article><strong>Gluten</strong><p>We cannot currently offer gluten-free food because our compact van kitchen cannot guarantee against cross-contamination.</p></article><article><strong>White pudding</strong><p>Our white pudding is vegetarian, but please ask us about cooking and cross-contamination before ordering.</p></article></div><p class="allergy">Tell us about any allergy or dietary requirement before you order. Product availability can vary at events and public stops.</p></div></section>
</BaseLayout>
<style>.menu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;align-items:start}.menu-section{padding:26px}.menu-head{display:flex;align-items:flex-start;gap:16px}.menu-head span{padding-top:8px;color:var(--red);font-size:.68rem;font-weight:900}.menu-section h2{margin:0;font-family:Georgia,serif;font-size:2rem}.price-head,.menu-section li{display:grid;grid-template-columns:minmax(0,1fr) repeat(var(--prices,1),74px);align-items:center;gap:12px}.price-head{grid-template-columns:minmax(0,1fr) repeat(2,74px);margin-top:23px;padding:0 0 8px;border-bottom:2px solid #222;color:#777;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}.price-head:has(strong:only-of-type){grid-template-columns:minmax(0,1fr) 74px}.price-head strong,.menu-section li strong{text-align:right}.menu-section ul{margin:0;padding:0;list-style:none}.menu-section li{padding:10px 0;border-bottom:1px solid #eee}.menu-section li span{font-weight:700}.menu-section li strong{color:var(--red);font-size:1.02rem}.diet-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px}.diet-grid article{padding:25px;border:1px solid #333;border-radius:20px;background:#191919}.diet-grid strong{color:#ff6268}.diet-grid p{color:#bbb}.allergy{margin-top:24px;color:#ddd}@media(max-width:800px){.menu-grid,.diet-grid{grid-template-columns:1fr}}@media(max-width:430px){.menu-section{padding:21px 17px}.price-head,.menu-section li{grid-template-columns:minmax(0,1fr) repeat(var(--prices,1),62px);gap:7px}.price-head{grid-template-columns:minmax(0,1fr) repeat(2,62px)}.price-head:has(strong:only-of-type){grid-template-columns:minmax(0,1fr) 62px}.menu-section li span{font-size:.91rem}.menu-section li strong{font-size:.94rem}}
</style>
