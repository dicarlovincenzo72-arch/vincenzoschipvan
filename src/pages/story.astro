---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Our Story | Vincenzo's Fish & Chips Van" description="The story of Vincenzo, Giuliana and the little black van — from a dream in 2017 to a multi award-winning mobile fish and chips business.">
<section class="page-hero"><div class="container"><div class="kicker">Vincenzo & Giuliana</div><h1 class="page-title">Our Story</h1><p class="lead">A dream that began in 2017, grew through hard work and became the little black van.</p></div></section>
<section class="section"><div class="container story-lead grid-2"><div><div class="kicker">More than fish & chips</div><h2 class="section-title">Food, family and community.</h2></div><div><p class="lead">Vincenzo’s story has always been about more than a meal. It is about welcoming people, serving generous food and supporting the places that support us.</p><p>Vincenzo and Giuliana built their reputation through long days, consistency and a genuine love of looking after customers. The awards followed, but the promise stayed the same: cook it fresh, serve it properly and never forget the people waiting at the hatch.</p></div></div></section>
<section class="section section-cream"><div class="container timeline"><article><span>2017</span><div><h2>The journey begins</h2><p>A dream, a strong work ethic and a commitment to proper fish and chips started the Vincenzo’s story.</p></div></article><article><span>2024</span><div><h2>Double Central Scotland award</h2><p>Best Fish Supper and Best Chip Shop recognised the quality and consistency behind the name.</p></div></article><article><span>2025</span><div><h2>Best Fish & Chip Shop — Stirling</h2><p>Another proud achievement, shared with the customers and team who made it possible.</p></div></article><article><span>2026</span><div><h2>The little black van takes to the road</h2><p>Our modern mobile kitchen brought Vincenzo’s food to villages, care homes, weddings, community days and major events across Scotland.</p></div></article><article><span>Today</span><div><h2>Van only — and moving forward</h2><p>We now focus on the little black van. Our Cowie premises are an operational base, not a walk-in shop.</p></div></article></div></section>
<section class="section section-dark"><div class="container grid-2 story-media"><div class="story-video"><video id="awardsVideo" controls playsinline preload="none" poster="/assets/images/mike-brewer.jpg" aria-label="Vincenzo's Fish and Chips awards video">Your browser does not support this video.</video><button id="awardsPlay" type="button" aria-label="Watch the awards video with sound"><span>▶</span> Watch with sound</button><div id="awardsLoading" role="status" hidden>Loading original video…</div></div><div><div class="kicker">A new chapter</div><h2 class="section-title">Built for the road.</h2><p class="lead">The van was created to carry the Vincenzo’s experience further — a proper commercial kitchen, a recognisable black exterior and the same family spirit at every stop.</p><div class="button-row"><a class="button button-red" href="/schedule">Find us today</a><a class="button button-light" href="/gallery">See the real journey</a></div></div></div></section>
<script>
  const video=document.getElementById('awardsVideo');
  const playButton=document.getElementById('awardsPlay');
  const loading=document.getElementById('awardsLoading');
  const parts=Array.from({length:13},(_,i)=>`/assets/videos/howard-awards/part-${String(i).padStart(2,'0')}`);
  let videoUrl='';
  playButton?.addEventListener('click',async()=>{
    if(!(video instanceof HTMLVideoElement)||videoUrl)return;
    playButton.hidden=true;
    if(loading)loading.hidden=false;
    try{
      const responses=await Promise.all(parts.map(path=>fetch(path)));
      if(responses.some(response=>!response.ok))throw new Error('Video unavailable');
      const buffers=await Promise.all(responses.map(response=>response.arrayBuffer()));
      videoUrl=URL.createObjectURL(new Blob(buffers,{type:'video/mp4'}));
      video.src=videoUrl;
      if(loading)loading.hidden=true;
      await video.play();
    }catch{
      if(loading){loading.hidden=false;loading.textContent='The video could not be loaded. Please try again.'}
      playButton.hidden=false;
    }
  });
  addEventListener('pagehide',()=>{if(videoUrl)URL.revokeObjectURL(videoUrl)},{once:true});
</script>
</BaseLayout>
<style>.story-lead p:not(.lead){color:var(--soft);font-size:1.05rem;line-height:1.8}.timeline{display:grid}.timeline article{display:grid;grid-template-columns:150px 1fr;gap:30px;padding:34px 0;border-bottom:1px solid var(--line)}.timeline span{color:var(--red);font-size:1.4rem;font-weight:900}.timeline h2{margin:0;font-family:Georgia,serif;font-size:2.1rem}.timeline p{max-width:680px;color:var(--soft)}.story-media{align-items:center}.story-video{position:relative;overflow:hidden;border-radius:26px;background:#000}.story-video video{width:100%;max-height:650px;object-fit:contain}.story-video button{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);display:flex;align-items:center;gap:10px;min-width:max-content;padding:14px 20px;border:0;border-radius:999px;background:var(--red);color:#fff;font:inherit;font-weight:900;box-shadow:0 8px 30px #0008}.story-video button span{font-size:1.1rem}.story-video button[hidden]{display:none}.story-video [role="status"]{position:absolute;inset:auto 18px 20px;padding:12px;border-radius:12px;background:#000c;color:#fff;text-align:center;font-weight:800}@media(max-width:650px){.timeline article{grid-template-columns:1fr;gap:8px}.story-video button{bottom:18px}}
</style>
