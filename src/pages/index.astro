---
import BaseLayout from '../layouts/BaseLayout.astro';
import {awards} from '../data/site';
import UpcomingStops from '../components/UpcomingStops.astro';
---
<BaseLayout title="Vincenzo's Fish & Chips Van® | Central Scotland" description="Follow Vincenzo, Giuliana and the little black van for multi award-winning fish and chips across Stirling District and Central Scotland.">
  <section class="hero" aria-label="Vincenzo's Fish & Chips Van">
    <div class="video-stage" aria-hidden="true">
      <video id="heroVideo1" class="hero-video is-active" autoplay muted playsinline preload="auto" poster="/assets/images/press/van-queue.jpg"><source src="/assets/videos/doune-gala-main.mp4" type="video/mp4"></video>
      <video id="heroVideo2" class="hero-video" muted playsinline preload="none" poster="/assets/images/press/van-launch.jpg"><source src="/assets/videos/doune-gala-second.mp4" type="video/mp4"></video>
    </div>
    <div class="hero-shade"></div>
    <div class="container hero-content"><h1>Vincenzo’s Fish &amp; Chips Van</h1><p class="hero-intro">Freshly cooked across Stirling &amp; Central Scotland.</p>
      <div class="button-row"><a class="button button-red" href="/schedule">Find our next stops</a><a class="button button-light" href="/events">Book us for an event</a></div>
      <a class="hero-award" href="/awards" aria-label="Discover Vincenzo's awards">
        <span class="award-copy">
          <span class="award-line award-line-main"><b aria-hidden="true">★</b><strong>Multi Award-Winning</strong><b aria-hidden="true">★</b></span>
          <span class="award-line award-line-place"><b aria-hidden="true">★</b><small>Central Scotland</small><b aria-hidden="true">★</b></span>
        </span>
      </a>
    </div>
    <button id="toggleVideos" class="video-toggle" type="button" aria-pressed="false">Pause video</button>
    <div class="video-progress"><button id="videoDot1" class="active" aria-label="Play first video"></button><button id="videoDot2" aria-label="Play second video"></button></div>
  </section>
<UpcomingStops />
<section class="section intro"><div class="container grid-2"><div><div class="kicker">Vincenzo, Giuliana & the little black van</div><h2 class="section-title">Freshly cooked.<br>Always welcoming.</h2></div><div><p class="lead">Award-winning fish and chips brought directly to communities and events across Scotland.</p><div class="simple-links"><a href="/story">Our story</a><a href="/menu">Explore the menu</a></div></div></div></section>

  <section class="awards-strip"><div class="container awards-grid">{awards.map(([title,place])=><article><h3>{title}</h3><p>{place}</p></article>)}</div></section>

  <section class="section real-section"><div class="container"><div class="grid-2 media-pair"><img src="/assets/images/community/bowhill-serving.jpg" alt="Vincenzo and Giuliana serving the crowd at Bowhill Highland Games" loading="lazy"><img src="/assets/images/community/vincenzo-giuliana-roselea.jpg" alt="Vincenzo and Giuliana ready to serve at Roselea Court" loading="lazy"></div><div class="real-copy"><div class="kicker">The real Vincenzo’s</div><h2 class="section-title">Real van. Real events. Real people.</h2><div class="simple-links"><a href="/gallery">Open the gallery</a></div></div></div></section>

  <section class="section event-call"><div class="container grid-2"><div><div class="kicker">Bring the van to you</div><h2 class="section-title">Make your event unforgettable.</h2><p class="lead">Freshly cooked food, generous portions and the warmest welcome.</p><div class="button-row"><a class="button button-red" href="/events">Event bookings</a><a class="button button-dark" href="tel:+447985522449">Call 07985 522 449</a></div></div><img src="/assets/images/community/bowhill-queue.jpg" alt="Customers enjoying the day at Bowhill Highland Games" loading="lazy"></div></section>

  <section class="section-tight section-dark"><div class="container notice-strip"><strong>VAN ONLY</strong><span>Our Cowie premises are our operational base — they are not a walk-in fish & chip shop.</span><a href="/schedule">See our dated stops →</a></div></section>

  <script is:inline>
  (()=>{const videos=[document.getElementById('heroVideo1'),document.getElementById('heroVideo2')].filter(Boolean),dots=[document.getElementById('videoDot1'),document.getElementById('videoDot2')],toggle=document.getElementById('toggleVideos');if(videos.length!==2)return;let current=0,switching=false,paused=matchMedia('(prefers-reduced-motion: reduce)').matches;const update=()=>{toggle.textContent=paused?'Play video':'Pause video';toggle.setAttribute('aria-pressed',String(paused))};videos.forEach(v=>{v.muted=true;v.playsInline=true;v.loop=false});const setActive=async(index)=>{if(switching||index===current||paused)return;switching=true;const out=videos[current],incoming=videos[index];try{incoming.currentTime=0;await incoming.play();out.classList.add('is-leaving');incoming.classList.add('is-active','is-entering');dots.forEach((d,i)=>d?.classList.toggle('active',i===index));setTimeout(()=>{out.classList.remove('is-active','is-leaving');out.pause();incoming.classList.remove('is-entering');current=index;switching=false;if(paused)incoming.pause()},1100)}catch{switching=false}};videos.forEach((v,i)=>{v.addEventListener('ended',()=>setActive(i===0?1:0));v.addEventListener('timeupdate',()=>{if(i===current&&!switching&&!paused&&v.duration-v.currentTime<1)setActive(i===0?1:0)})});dots.forEach((d,i)=>d?.addEventListener('click',()=>{paused=false;update();if(i===current)videos[i].play().catch(()=>{});else setActive(i)}));toggle.addEventListener('click',()=>{paused=!paused;update();if(paused)videos.forEach(v=>v.pause());else videos[current].play().catch(()=>{})});update();if(paused)videos.forEach(v=>v.pause());else videos[0].play().catch(()=>{});})();
  </script>
</BaseLayout>
<style>
.hero-content h1{max-width:800px;font-family:Georgia,serif;font-size:clamp(2.4rem,5vw,4.8rem);line-height:1.04;margin:0}.hero-intro{font-size:clamp(1rem,2vw,1.3rem);margin:16px 0 0}.hero-shade{background:linear-gradient(0deg,rgba(0,0,0,.82),rgba(0,0,0,.18) 65%)}

.hero{position:relative;min-height:100svh;display:grid;align-items:end;overflow:hidden;background:#777;color:#fff}.video-stage,.hero-video,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-video{object-fit:cover;opacity:0;transition:opacity 1.1s ease,transform 7s linear;transform:scale(1.02)}.hero-video.is-active{opacity:1;transform:scale(1.05)}.hero-video.is-leaving{opacity:0}.hero-shade{background:linear-gradient(90deg,rgba(0,0,0,.28),rgba(0,0,0,.02) 72%),linear-gradient(0deg,rgba(0,0,0,.32),transparent 43%)}.hero-content{position:relative;z-index:2;padding-top:160px;padding-bottom:52px;text-shadow:0 3px 22px rgba(0,0,0,.55)}.hero-content .button-row{max-width:540px}.hero-award{display:grid;grid-template-columns:auto 1fr;align-items:center;width:max-content;max-width:100%;column-gap:13px;margin-top:18px;padding:14px 21px;border:1px solid var(--gold);border-radius:16px;background:rgba(0,0,0,.74);color:var(--gold);text-transform:uppercase;text-shadow:0 3px 4px #000,0 0 14px rgba(0,0,0,.95);box-shadow:0 8px 28px rgba(0,0,0,.3);backdrop-filter:blur(8px)}.hero-award>span{grid-row:1/3;color:var(--gold);font-size:1.45rem}.hero-award strong{font-family:Arial,Helvetica,sans-serif;font-size:1.42rem;font-weight:1000;line-height:1;letter-spacing:.035em}.hero-award small{margin-top:5px;color:#fff;font-size:.9rem;font-style:normal;font-weight:1000;line-height:1;letter-spacing:.2em}.video-progress{position:absolute;z-index:3;right:28px;bottom:38px;display:flex;gap:7px}.video-progress button{width:28px;height:4px;padding:0;border:0;border-radius:10px;background:#ffffff66}.video-progress button.active{width:56px;background:#fff}.intro{background:#fff}.simple-links{display:flex;flex-wrap:wrap;gap:28px;margin-top:28px}.simple-links a{padding-bottom:6px;border-bottom:1px solid currentColor;font-size:.72rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.awards-strip{padding:55px 0;background:var(--cream);border-block:1px solid #e5ded3}.awards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0}.awards-grid article{padding:8px 32px;text-align:center;border-right:1px solid #ddd5ca}.awards-grid article:last-child{border-right:0}.awards-grid h3{margin:0;font-family:Georgia,serif;font-size:1.4rem;font-weight:400}.awards-grid p{margin:8px 0 0;color:var(--soft);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}.real-section{background:#fff}.media-pair img{width:100%;height:430px;object-fit:cover;border-radius:18px}.real-copy{margin:42px auto 0;text-align:center}.real-copy .section-title{margin-inline:auto;font-size:clamp(2.5rem,5vw,4.8rem)}.real-copy .simple-links{justify-content:center}.event-call{background:var(--cream)}.event-call img{width:100%;height:520px;object-fit:cover;border-radius:20px}.notice-strip{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px}.notice-strip strong{color:var(--red-on-dark);letter-spacing:.12em}.notice-strip span{color:#ccc}.notice-strip a{font-weight:900}@media(max-width:800px){.hero-shade{background:linear-gradient(0deg,rgba(0,0,0,.44),rgba(0,0,0,.01) 60%)}.hero-content{padding-bottom:46px}.hero-content .button-row{max-width:none}.hero-award{width:100%;grid-template-columns:auto 1fr;margin-top:14px;padding:13px 15px}.hero-award>span{font-size:1.35rem}.hero-award strong{font-size:1.23rem;letter-spacing:.015em}.hero-award small{font-size:.78rem;letter-spacing:.13em}.awards-grid{grid-template-columns:1fr}.awards-grid article{padding:24px 12px;border-right:0;border-bottom:1px solid #ddd5ca}.awards-grid article:last-child{border-bottom:0}.media-pair img{height:300px}.event-call img{height:420px}.notice-strip{grid-template-columns:1fr;text-align:center}.video-progress{bottom:20px}}
.hero-award{display:flex;align-items:center;justify-content:center;text-align:center}
.award-copy{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;gap:8px;line-height:1}
.award-line{display:flex;align-items:center;justify-content:center;width:100%;gap:11px}
.award-line b{color:var(--gold);font-size:1.15rem;line-height:1}
.award-line-place b{font-size:1rem}
.hero-award strong{animation:award-glow 6s ease-in-out infinite}
.hero-award small{margin-top:0;animation:none}
.hero-award .award-line b{animation:none}
@keyframes award-glow{0%,100%{color:var(--gold);text-shadow:0 1px 3px #000}50%{color:var(--gold);text-shadow:0 1px 3px #000,0 0 6px rgba(217,173,85,.22)}}
@media(prefers-reduced-motion:reduce){.hero-award strong,.hero-award small,.hero-award .award-line b{animation:none}}
.hero-shade{background:linear-gradient(0deg,rgba(0,0,0,.82),rgba(0,0,0,.18) 65%)}
.video-toggle{position:absolute;right:28px;bottom:62px;z-index:3;padding:8px 14px;border:1px solid #ffffff99;border-radius:999px;background:#111b;color:#fff;font-size:.8rem;cursor:pointer}@media(max-width:800px){.video-toggle{bottom:40px}.hero-content{padding-bottom:105px}}

/* Consistent centred section headings and information cards. */
.hero-content{text-align:center}.hero-content h1{margin-inline:auto;font-size:clamp(2.4rem,4.5vw,4rem);text-wrap:balance}.hero-content .button-row{max-width:none;justify-content:center}.hero-award{margin-inline:auto}.intro .grid-2{align-items:center}.intro,.event-call{text-align:center}.intro .lead,.event-call .lead{margin-inline:auto}.simple-links,.event-call .button-row{justify-content:center}.real-copy .section-title{font-size:clamp(2rem,3.6vw,3.5rem);line-height:1.12}.notice-strip{text-align:center}
</style>

