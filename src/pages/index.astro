---
import BaseLayout from '../layouts/BaseLayout.astro';
import {awards} from '../data/site';
---
<BaseLayout title="Vincenzo's Fish & Chips Van® | Central Scotland" description="Follow Vincenzo, Giuliana and the little black van for multi award-winning fish and chips across Stirling District and Central Scotland.">
  <section class="hero" aria-label="Vincenzo's Fish & Chips Van">
    <div class="video-stage" aria-hidden="true">
      <video id="heroVideo1" class="hero-video is-active" autoplay muted playsinline preload="auto" poster="/assets/images/press/van-queue.jpg"><source src="/assets/videos/doune-gala-main.mp4" type="video/mp4"></video>
      <video id="heroVideo2" class="hero-video" muted playsinline preload="auto" poster="/assets/images/press/van-launch.jpg"><source src="/assets/videos/doune-gala-second.mp4" type="video/mp4"></video>
    </div>
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <span class="eyebrow-pill">🇮🇹 Multi award-winning · Central Scotland 🏴󠁧󠁢󠁳󠁣󠁴󠁿</span>
      <h1>Proper Fish & Chips.<br><em>The Vincenzo’s way.</em></h1>
      <p>Freshly cooked, generous portions and the warmest welcome — served from our little black van.</p>
      <div class="button-row"><a class="button button-red" href="/schedule">Find the van today</a><a class="button button-light" href="/events">Book us for an event</a></div>
    </div>
    <div class="video-progress"><button id="videoDot1" class="active" aria-label="Play first video"></button><button id="videoDot2" aria-label="Play second video"></button></div>
  </section>

  <section class="section intro"><div class="container grid-2"><div><div class="kicker">Vincenzo, Giuliana & the little black van</div><h2 class="section-title">Bringing our award-winning food to you.</h2></div><div><p class="lead">We serve villages, care homes, weddings, gala days, festivals and private events across Stirling District, Central Scotland and beyond.</p><div class="button-row"><a class="button button-dark" href="/story">Our story</a><a class="button button-red" href="/menu">Explore the menu</a></div></div></div></section>

  <section class="section section-dark"><div class="container"><div class="kicker">Proud winners</div><h2 class="section-title">Recognition built on hard work.</h2><div class="awards-grid">{awards.map(([title,place],i)=><article><span>0{i+1}</span><h3>{title}</h3><p>{place}</p></article>)}</div><div class="button-row"><a class="button button-light" href="/awards">See our awards</a></div></div></section>

  <section class="section section-cream"><div class="container"><div class="grid-2 media-pair"><img src="/assets/images/press/van-launch.jpg" alt="The real little black van at an event" loading="lazy"><img src="/assets/images/press/van-queue.jpg" alt="Customers queuing at Vincenzo's Fish & Chips Van" loading="lazy"></div><div class="real-copy"><div class="kicker">Real van. Real events. Real people.</div><h2 class="section-title">No stock photography. This is our journey.</h2><p class="lead">Every photograph and video on this site belongs to the real story of Vincenzo’s Fish & Chips Van.</p><div class="button-row"><a class="button button-red" href="/gallery">Open the gallery</a></div></div></div></section>

  <section class="section event-call"><div class="container grid-2"><div><div class="kicker">Planning something special?</div><h2 class="section-title">Let the little black van feed the crowd.</h2><p class="lead">From Highland Games to weddings and private celebrations, we bring freshly cooked fish and chips directly to your event.</p><div class="button-row"><a class="button button-red" href="/events">Event bookings</a><a class="button button-dark" href="tel:+447985522449">Call 07985 522 449</a></div></div><img src="/assets/images/award-stage.jpg" alt="Vincenzo receiving an award" loading="lazy"></div></section>

  <section class="section-tight section-dark"><div class="container notice-strip"><strong>VAN ONLY</strong><span>Our Cowie premises are our operational base — they are not a walk-in fish & chip shop.</span><a href="/schedule">See today’s stops →</a></div></section>

  <script is:inline>
  (()=>{const videos=[document.getElementById('heroVideo1'),document.getElementById('heroVideo2')].filter(Boolean),dots=[document.getElementById('videoDot1'),document.getElementById('videoDot2')];if(videos.length!==2)return;let current=0,switching=false;videos.forEach(v=>{v.muted=true;v.playsInline=true;v.loop=false});const setActive=async(index)=>{if(switching||index===current)return;switching=true;const out=videos[current],incoming=videos[index];try{incoming.currentTime=0;await incoming.play();out.classList.add('is-leaving');incoming.classList.add('is-active','is-entering');dots.forEach((d,i)=>d?.classList.toggle('active',i===index));setTimeout(()=>{out.classList.remove('is-active','is-leaving');out.pause();incoming.classList.remove('is-entering');current=index;switching=false},1100)}catch{switching=false}};videos.forEach((v,i)=>{v.addEventListener('ended',()=>setActive(i===0?1:0));v.addEventListener('timeupdate',()=>{if(i===current&&!switching&&v.duration-v.currentTime<1)setActive(i===0?1:0)})});dots.forEach((d,i)=>d?.addEventListener('click',()=>setActive(i)));videos[0].play().catch(()=>{});})();
  </script>
</BaseLayout>
<style>
.hero{position:relative;min-height:100svh;display:grid;align-items:end;overflow:hidden;background:#111;color:#fff}.video-stage,.hero-video,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-video{object-fit:cover;opacity:0;transition:opacity 1.1s ease,transform 7s linear;transform:scale(1.02)}.hero-video.is-active{opacity:1;transform:scale(1.07)}.hero-video.is-leaving{opacity:0}.hero-shade{background:linear-gradient(90deg,rgba(0,0,0,.82),rgba(0,0,0,.22) 65%),linear-gradient(0deg,rgba(0,0,0,.68),transparent 55%)}.hero-content{position:relative;z-index:2;padding-top:160px;padding-bottom:105px}.hero h1{max-width:900px;margin:22px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(3.6rem,8vw,8rem);line-height:.91;letter-spacing:-.055em}.hero h1 em{color:#ff4a51;font-style:normal}.hero-content>p{max-width:670px;margin:25px 0 0;color:#e3e3e3;font-size:clamp(1.05rem,2vw,1.28rem)}.video-progress{position:absolute;z-index:3;right:28px;bottom:38px;display:flex;gap:7px}.video-progress button{width:28px;height:4px;padding:0;border:0;border-radius:10px;background:#ffffff66}.video-progress button.active{width:56px;background:#fff}.awards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}.awards-grid article{padding:28px;border:1px solid #363636;border-radius:22px;background:#191919}.awards-grid span{color:#ff6268;font-size:.7rem;font-weight:900}.awards-grid h3{margin:28px 0 8px;font-family:Georgia,serif;font-size:2rem;line-height:1}.awards-grid p{color:#aaa}.media-pair img{width:100%;height:430px;object-fit:cover;border-radius:24px}.real-copy{margin-top:46px}.event-call img{width:100%;height:560px;object-fit:cover;border-radius:28px}.notice-strip{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px}.notice-strip strong{color:#ff555b;letter-spacing:.12em}.notice-strip span{color:#ccc}.notice-strip a{font-weight:900}@media(max-width:800px){.hero-content{padding-bottom:110px}.awards-grid{grid-template-columns:1fr}.media-pair img{height:300px}.event-call img{height:420px}.notice-strip{grid-template-columns:1fr;text-align:center}.video-progress{bottom:20px}}
</style>
